{
  "name": "mozrabi-orchestra-backend",
  "version": "1.0.0",
  "description": "REST API for the Mozrabi Orchestra of Isfahan website (Express + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "node prisma/seed.js",
    "dev:postgres": "node scripts/dev-postgres.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
